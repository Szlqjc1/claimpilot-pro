{
  "name": "claimpilot-pro",
  "version": "0.1.0",
  "private": true,
  "description": "ClaimPilot PRO — AI-RPA expense review for Ironwood Safety Systems (demo)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "predev": "node scripts/preflight.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "node scripts/ensure-env.mjs && prisma generate",
    "db:reset": "prisma migrate reset --force --skip-seed && prisma db seed",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "receipts:generate": "tsx scripts/generate-receipts.ts",
    "kpi:report": "tsx scripts/kpi-report.ts",
    "shots": "tsx scripts/screenshots.ts",
    "cost:curve": "tsx --conditions=react-server scripts/cost-curve.ts",
    "bench:degrade": "tsx scripts/degrade.ts",
    "bench:grounding": "tsx scripts/grounding-bench.ts",
    "bench:variants": "tsx --conditions=react-server scripts/extraction-variants.ts",
    "bench:illumination": "tsx --conditions=react-server scripts/illumination-ab.ts",
    "a11y:audit": "tsx scripts/a11y-audit.ts",
    "evidence:shots": "tsx scripts/evidence-shots.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/client": "^6.16.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "jpeg-js": "0.4.4",
    "lucide-react": "^0.544.0",
    "next": "^15.5.4",
    "pngjs": "7.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.2.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "^6.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "playwright": "^1.64.1",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
