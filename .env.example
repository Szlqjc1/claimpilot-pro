DATABASE_URL="file:./dev.db"

# mock | live
AI_MODE="mock"
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# fixture | tesseract
OCR_MODE="fixture"
# on | off: detect the page in an uploaded photo and warp it flat before OCR (DECISIONS D-50)
OCR_RECTIFY="on"
MAX_UPLOAD_MB="10"

# Login session lifetime (hours)
SESSION_TTL_HOURS="24"
